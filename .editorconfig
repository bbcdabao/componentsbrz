root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = false
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[node_modules/**]
indent_style = ignore

[build/**]
indent_style = ignore

[dist/**]
indent_style = ignore
